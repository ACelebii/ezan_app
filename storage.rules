rules_version = '2';

// Kütüphane: kapak görselleri ve PDF'ler herkese açık okunur, yazma yok
// (dosyalar Firebase Console > Storage üzerinden elle yükleniyor).
service firebase.storage {
  match /b/{bucket}/o {
    match /kutuphane/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
